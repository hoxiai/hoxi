  },
  "info": {
    "companyName": "Hoxi (hoxi.ai)",
    "productName": "Hoxi",
    "productVersion": "0.4.1",
    "copyright": "Copyright © 2026 Hoxi (https://hoxi.ai)",
    "comments": "Hoxi — native command center for parallel AI engineering (https://hoxi.ai)",
    "protocols": [
      {
        "scheme": "hoxi",
        "description": "Hoxi desktop authentication callback",
        "role": "Viewer"
      }
    ]
  }
}
