# Public build configuration for hoxi.ai.
# English is the default (served at /), Simplified Chinese at /zh, Traditional
# Chinese at /zh-HK. Supply database/session secrets separately; this file only
# pins public build inputs.
APAY_BUILD_THEMES=hoxi
APAY_LOCALES=en,zh,zh-HK
APAY_DEFAULT_LOCALE=en
APAY_PUBLIC_PROTOCOL=https
