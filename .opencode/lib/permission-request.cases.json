  { "name": "external directory without targets", "destructive": true, "request": { "permission": "external_directory", "patterns": [] } },
  { "name": "doom loop", "destructive": true, "request": { "permission": "doom_loop", "patterns": ["bash"] } },
  { "name": "plain edit", "destructive": false, "request": { "permission": "edit", "patterns": ["src/App.tsx"] } },
  { "name": "git config edit", "destructive": true, "request": { "permission": "edit", "patterns": [".git/config"] } },
  { "name": "envrc edit", "destructive": true, "request": { "permission": "edit", "patterns": [".envrc"] } },
  { "name": "plugin write via metadata", "destructive": true, "request": { "permission": "write", "metadata": { "filepath": "/repo/.opencode/plugins/x.js" } } },
