[
  { "name": "plain file read", "destructive": false, "request": { "permission": "read", "patterns": ["src/main.go"] } },
  { "name": "dotenv read", "destructive": true, "request": { "permission": "read", "patterns": ["/repo/.env"] } },
  { "name": "dotenv production read", "destructive": true, "request": { "permission": "read", "patterns": ["/repo/.env.production"] } },
  { "name": "dotenv read via metadata", "destructive": true, "request": { "permission": "read", "patterns": [], "metadata": { "filepath": "/repo/.env.local" } } },
  { "name": "dotenv example read", "destructive": false, "request": { "permission": "read", "patterns": ["/repo/.env.example"] } },
  { "name": "ssh key read", "destructive": true, "request": { "permission": "read", "patterns": ["/Users/u/.ssh/id_ed25519"] } },
  { "name": "git config read stays routine", "destructive": false, "request": { "permission": "read", "patterns": [".git/config"] } },
  { "name": "grep pattern is not a command", "destructive": false, "request": { "permission": "grep", "patterns": ["sudo rm -rf"] } },
  { "name": "glob pattern is not a read", "destructive": false, "request": { "permission": "glob", "patterns": [".env"] } },
  { "name": "routine sibling directory", "destructive": false, "request": { "permission": "external_directory", "patterns": ["/Users/u/code/sibling/*"] } },
