  { "name": "runner write to claude settings", "destructive": true, "request": { "permission": "tool", "patterns": ["Write"], "metadata": { "tool": "Write", "args": "{\"file_path\":\"/repo/.claude/settings.json\"}" } } },
  { "name": "runner read of dotenv", "destructive": true, "request": { "permission": "tool", "patterns": ["Read"], "metadata": { "tool": "Read", "filepath": "/repo/.env" } } },
  { "name": "runner sibling read", "destructive": false, "request": { "permission": "tool", "patterns": ["Read"], "metadata": { "tool": "Read", "externalDirectory": true, "args": "{\"file_path\":\"/Users/u/code/sibling/a.ts\"}" } } },
  { "name": "runner etc read", "destructive": true, "request": { "permission": "tool", "patterns": ["Read"], "metadata": { "tool": "Read", "externalDirectory": true, "args": "{\"file_path\":\"/etc/passwd\"}" } } },
  { "name": "runner destructive flag", "destructive": true, "request": { "permission": "tool", "patterns": ["call_mcp_tool"], "metadata": { "tool": "call_mcp_tool", "destructive": true } } },
  { "name": "unsandboxed tool", "destructive": true, "request": { "permission": "tool", "patterns": ["unsandboxed"], "metadata": { "tool": "unsandboxed" } } },
