{
  "name": "hoxi-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "esbuild scripts/run-tests.ts --bundle --platform=node --format=esm --loader:.svg=text | node --input-type=module -",
    "check:i18n": "esbuild scripts/check-i18n.ts --bundle --platform=node --format=esm | node --input-type=module -",
    "check:lines": "esbuild scripts/check-lines.ts --bundle --platform=node --format=esm | node --input-type=module -",
    "lint": "tsc --noEmit && npm run check:i18n && npm run check:lines"
  },
  "dependencies": {
    "@pierre/diffs": "^1.5.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-solid": "^0.475.0",
    "shiki": "^4.5.0",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-solid": "^2.11.2"
  }
}
